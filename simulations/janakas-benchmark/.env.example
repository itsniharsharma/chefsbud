# Simulation target (local app + API)
BASE_WEB_URL=http://localhost:5173
BASE_API_URL=http://localhost:5000/api
RESTAURANT_SLUG=janakas

# Scope
TABLE_MIN=1
TABLE_MAX=25
FLOOR_MIN=1
FLOOR_MAX=2
ORDERS_PER_DAY_MIN=300
ORDERS_PER_DAY_MAX=600
SIMULATION_MINUTES=60

# Optional auth/admin reads (set both to enable)
ADMIN_BEARER_TOKEN=
ADMIN_RESTAURANT_ID=

# Infra samplers (optional but recommended for DB/Redis metrics)
MONGO_URI=
MONGO_DB_NAME=chefsbud
REDIS_URL=

# Optional: monitor local backend process memory by PID
APP_PID=

# Tooling
K6_BIN=k6
SAMPLE_INTERVAL_MS=5000

# Optional override when running k6 manually (runner sets this automatically)
LOAD_MODE=steady
