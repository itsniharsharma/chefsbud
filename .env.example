# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development        # production | development
PORT=5000                   # Render sets this automatically in production

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/chefs_bud
MONGO_MAX_POOL_SIZE=15
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_SOCKET_TIMEOUT_MS=45000

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-secret

# ─── CORS ────────────────────────────────────────────────────────────────────
# Development:
CORS_ORIGIN=http://localhost:5173
# Production (set in Render dashboard):
# CORS_ORIGIN=https://chefsbud.com,https://www.chefsbud.com

# ─── AI ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_HYBRID_MONTHLY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT_MS=10000
WEBHOOK_PROCESSED_TTL_SECONDS=86400
WEBHOOK_LOCK_TTL_SECONDS=120
ANALYTICS_BACKFILL_LOCK_SECONDS=120
ANALYTICS_BACKFILL_BATCH_SIZE=250
ANALYTICS_BACKFILL_MAX_BATCHES_PER_RUN=8
# Register this URL in your Razorpay dashboard > Webhooks:
# https://api.chefsbud.com/api/payments/webhook
BILLING_GRACE_DAYS=7
CUSTOMER_FEEDBACK_WINDOW_MINUTES=60
RATE_LIMIT_PUBLIC_ORDER_RATING_CAPACITY=20
RATE_LIMIT_PUBLIC_ORDER_RATING_WINDOW_MS=60000

# ─── Azure Archival ──────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=orders-archive
ORDER_ARCHIVE_ENABLED=true
PROCESS_ROLE=all
ORDER_ARCHIVE_INTERVAL_MINUTES=60
ORDER_ARCHIVE_DELAY_HOURS=6
ORDER_ARCHIVE_BATCH_SIZE=500
ORDER_ARCHIVE_PURGE_AFTER_UPLOAD=true

# ─── Performance Observability ───────────────────────────────────────────────
PERF_METRICS_ENABLED=true
PERF_METRICS_FLUSH_INTERVAL_MS=60000
PERF_METRICS_MAX_KEYS_PER_FAMILY=500
ANALYTICS_INLINE_BACKFILL_MIN_INTERVAL_MS=60000
ANALYTICS_WARM_STATE_RETENTION_MS=86400000
ANALYTICS_WARM_STATE_MAX_ENTRIES=10000
MONGO_COMMAND_TRACKER_MAX_ENTRIES=20000
MONGO_COMMAND_TRACKER_STALE_MS=300000

# ─── SMTP ────────────────────────────────────────────────────────────────────
MAIL_PROVIDER=smtp
# For Mailtrap transactional API:
# MAIL_PROVIDER=mailtrap_api
# MAILTRAP_API_TOKEN=
# MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chef's Bud <hello@chefsbud.com>
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_MAX_RESENDS=8
REGISTRATION_PENDING_TTL_MINUTES=60

# ─── Server timeouts ─────────────────────────────────────────────────────────
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Development: /api is proxied by Vite dev server to localhost:5000
VITE_API_BASE_URL=/api
# Production: set https://api.chefsbud.com/api in Vercel dashboard
# VITE_API_BASE_URL=https://api.chefsbud.com/api
VITE_FRONTEND_BASE_URL=http://localhost:5173
# Production:
# VITE_FRONTEND_BASE_URL=https://chefsbud.com
